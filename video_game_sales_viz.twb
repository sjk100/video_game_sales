            <column-instance column='[trending_slope]' derivation='Sum' name='[sum:trending_slope:qk]' pivot='key' type='quantitative' />
            <column caption='Trending Slope' datatype='real' name='[trending_slope]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
