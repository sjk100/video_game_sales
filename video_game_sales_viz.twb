      <layout-options>
        <title>
          <formatted-text>
            <run>Which genres show growth over the last decade?
</run>
            <run fontsize='9'>Only Action, Role-Playing, and Shooter have a positive trend.</run>
          </formatted-text>
        </title>
      </layout-options>
