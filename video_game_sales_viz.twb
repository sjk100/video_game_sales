            <column caption='categorise' datatype='string' name='[Calculation_0120730889809922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [trending_slope] &gt;= 0 THEN &quot;Positive&quot;&#13;&#10;ELSE &quot;Negative&quot;&#13;&#10;END' />
            </column>
            <column caption='Genre' datatype='string' name='[genre]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0120730889809922]' derivation='None' name='[none:Calculation_0120730889809922:nk]' pivot='key' type='nominal' />
