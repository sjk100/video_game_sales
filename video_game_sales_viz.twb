      <column caption='Quadrant' datatype='string' name='[Calculation_0316443561414658]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [attractiveness_score] &gt; {FIXED : AVG([attractiveness_score])}&#13;&#10;AND [norm_hhi] &gt; {FIXED : AVG([norm_hhi])}&#13;&#10;THEN &quot;Established&quot;&#13;&#10;&#13;&#10;ELSEIF [attractiveness_score] &gt; {FIXED : AVG([attractiveness_score])}&#13;&#10;AND [norm_hhi] &lt;= {FIXED : AVG([norm_hhi])}&#13;&#10;THEN &quot;Target&quot;&#13;&#10;&#13;&#10;ELSEIF [attractiveness_score] &lt;= {FIXED : AVG([attractiveness_score])}&#13;&#10;AND [norm_hhi] &lt;= {FIXED : AVG([norm_hhi])}&#13;&#10;THEN &quot;Foothold&quot;&#13;&#10;&#13;&#10;ELSE &quot;Avoid&quot;&#13;&#10;END' />
