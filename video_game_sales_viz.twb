                    <run>Æ&#10;</run>
                    <run bold='true'>Below Median: Sales between 0.5x median and median</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>Weak Entry: Sales below 0.5x median</run>
                  </formatted-text>
